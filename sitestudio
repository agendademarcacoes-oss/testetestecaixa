            bottom: 100px;

            right: 25px;

            width: 48px;

            height: 48px;

            border-radius: 50%;

            border:
                1px solid
                rgba(255,255,255,.15);

            background:
                rgba(38,25,176,.85);

            color: white;

            display: grid;

            place-items: center;

            cursor: pointer;

            z-index: 2500;

            opacity: 0;

            visibility: hidden;

            transform:
                translateY(15px);

            transition: .3s ease;
        }


        .back-to-top.visible {

            opacity: 1;

            visibility: visible;

            transform:
                translateY(0);
        }


        .back-to-top:hover {

            transform:
