    <style>

        /* =====================================================
           ROOT
           ===================================================== */

        :root {

            --primary: #2619b0;
            --primary-dark: #171064;
            --primary-light: #5548e5;

            --purple: #766aff;

            --gold: #c9a769;
            --gold-light: #e4ca92;

            --background: #070711;
            --background-2: #0d0c1c;

            --white: #ffffff;

            --text: #f5f4ff;
            --text-soft: #c4c1d5;
            --text-muted: #9490a8;

            --glass: rgba(255,255,255,0.075);
            --glass-strong: rgba(255,255,255,0.12);
            --glass-border: rgba(255,255,255,0.14);

            --shadow:
                0 30px 80px rgba(0,0,0,0.35);

            --radius: 28px;

            --header-height: 76px;

        }


        /* =====================================================
           RESET
           ===================================================== */

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
        }

        body {

            font-family: "Inter", sans-serif;

            color: var(--text);

            background:
                radial-gradient(
                    circle at 10% 10%,
                    rgba(38,25,176,0.45),
                    transparent 32%
                ),

                radial-gradient(
                    circle at 90% 25%,
                    rgba(118,106,255,0.18),
                    transparent 30%
                ),

                radial-gradient(
                    circle at 50% 100%,
                    rgba(38,25,176,0.35),
                    transparent 35%
                ),

                var(--background);

            min-height: 100vh;

            overflow-x: hidden;

            line-height: 1.6;
        }


        body::before {

            content: "";

            position: fixed;

            inset: 0;

            pointer-events: none;

            z-index: -1;

            background:
                linear-gradient(
                    120deg,
                    rgba(255,255,255,0.025),
                    transparent 30%,
                    rgba(255,255,255,0.015)
                );
        }


        img {

            max-width: 100%;

            display: block;
        }


        a {

            color: inherit;

            text-decoration: none;
        }


        button,
        input {

            font-family: inherit;
        }


        /* =====================================================
           LIQUID GLASS
           ===================================================== */

        .glass {

            background:
                linear-gradient(
                    135deg,
                    rgba(255,255,255,0.11),
                    rgba(255,255,255,0.035)
                );

            border:

                1px solid
                rgba(255,255,255,0.13);

            backdrop-filter:
                blur(25px)
                saturate(150%);

            -webkit-backdrop-filter:
                blur(25px)
                saturate(150%);

            box-shadow:

                0 25px 80px
                rgba(0,0,0,0.25),

                inset 0 1px
                rgba(255,255,255,0.12);
        }


        /* =====================================================
           TOP MUSIC BAR
           ===================================================== */

        .music-bar {

            position: fixed;

            top: 12px;

            left: 50%;

            transform: translateX(-50%);

            width: min(650px, calc(100% - 24px));

            min-height: 48px;

            padding: 7px 10px;

            border-radius: 18px;

            display: flex;

            justify-content: center;

            align-items: center;

            gap: 14px;

            z-index: 3000;

            color: var(--white);

            background:
                rgba(14,13,36,0.72);

            border:
                1px solid
                rgba(255,255,255,0.15);

            backdrop-filter:
                blur(22px);

            box-shadow:
                0 12px 45px
                rgba(0,0,0,0.35);
        }


        .music-label {

            font-size: 12px;

            color: var(--text-soft);

            letter-spacing: .08em;

            text-transform: uppercase;
        }


        .music-controls {

            display: flex;

            align-items: center;

            gap: 8px;
        }


        #musicToggle {

            width: 34px;

            height: 34px;

            border: none;

            border-radius: 50%;

            background: var(--primary);

            color: white;

            cursor: pointer;

            display: grid;

            place-items: center;

            transition: .25s ease;

            box-shadow:
                0 8px 25px
                rgba(38,25,176,.45);
        }


        #musicToggle:hover {

            transform: scale(1.08);

            background: var(--primary-light);
        }


        #musicToggle:active {

            transform: scale(.94);
        }


        .music-progress {

            width: 100px;

            height: 3px;

            appearance: none;

            background:
                rgba(255,255,255,.15);

            border-radius: 20px;

            cursor: pointer;
        }


        /* =====================================================
           HEADER
           ===================================================== */

        .header-wrapper {

            position: sticky;

            top: 70px;

            z-index: 2000;

            width: min(1200px, calc(100% - 28px));

            margin: 84px auto 0;

            border-radius: 24px;

            background:
                rgba(12,11,30,.68);

            border:
                1px solid
                rgba(255,255,255,.13);

            backdrop-filter:
                blur(24px)
                saturate(160%);

            -webkit-backdrop-filter:
                blur(24px)
                saturate(160%);

            box-shadow:
                0 20px 70px
                rgba(0,0,0,.25);
        }


        .header-content {

            min-height: var(--header-height);

            display: flex;

            align-items: center;

            justify-content: space-between;

            padding: 10px 18px;
        }


        .logo-title-container {

            display: flex;

            align-items: center;

            gap: 13px;
        }


        .logo-link {

            display: block;
        }


        .logo-img {

            width: 58px;

            height: 58px;

            object-fit: cover;

            border-radius: 50%;

            border:
                1px solid
                rgba(255,255,255,.2);

            transition: .3s ease;

            box-shadow:
                0 8px 30px
                rgba(0,0,0,.3);
        }


        .logo-img:hover {

            transform:
                scale(1.06)
                rotate(2deg);
        }


        .blog-title {

            font-family:
                "Playfair Display",
                serif;

            font-size: 1.5rem;

            color: white;

            position: relative;

            padding-bottom: 6px;
        }


        .blog-title::after {

            content: "";

            position: absolute;

            left: 0;

            bottom: 0;

            width: 34px;

            height: 2px;

            background:
                var(--gold);
        }


        /* =====================================================
           NAVIGATION
           ===================================================== */

        .nav-desktop {

            display: block;
        }


        .nav-menu {

            display: flex;

            align-items: center;

            gap: 4px;

            list-style: none;
        }


        .nav-link {

            display: flex;

            align-items: center;

            gap: 7px;

            padding: 10px 12px;

            border-radius: 13px;

            color: var(--text-soft);

            font-size: 12px;

            font-weight: 600;

            text-transform: uppercase;

            letter-spacing: .04em;

            transition: .25s ease;
        }


        .nav-link i {

            color:
                var(--gold);
        }


        .nav-link:hover,
        .nav-link.active {

            color: white;

            background:
                rgba(255,255,255,.08);

            transform:
                translateY(-1px);
        }


        .admin-link {

            border:
                1px solid
                rgba(255,255,255,.13);
        }


        /* =====================================================
           MENU MOBILE
           ===================================================== */

        .menu-toggle {

            display: none;

            width: 44px;

            height: 44px;

            border: none;

            border-radius: 14px;

            background:
                rgba(255,255,255,.08);

            color: white;

            font-size: 20px;

            cursor: pointer;
        }


        .mobile-menu-overlay {

            display: none;
        }


        /* =====================================================
           HERO
           ===================================================== */

        .hero-section {

            position: relative;

            min-height: 760px;

            width: 100%;

            overflow: hidden;

            margin-top: 20px;
        }


        .carousel {

            position: relative;

            width: 100%;

            height: 760px;
        }


        .carousel-inner {

            position: absolute;

            inset: 0;

            overflow: hidden;
        }


        .carousel-item {

            position: absolute;

            inset: 0;

            display: flex;

            align-items: center;

            justify-content: center;

            text-align: center;

            background-size: cover;

            background-position: center;

            opacity: 0;

            transition:
                opacity 1s ease;

            overflow: hidden;
        }


        .carousel-item::before {

            content: "";

            position: absolute;

            inset: 0;

            background:
                linear-gradient(
                    90deg,
                    rgba(5,5,15,.88),
                    rgba(38,25,176,.38),
                    rgba(5,5,15,.75)
                );
        }


        .carousel-item.active {

            opacity: 1;
        }


        .carousel-caption {

            position: relative;

            z-index: 2;

            width: min(900px, calc(100% - 32px));

            padding: 60px 30px;

            border-radius: 38px;

            background:
                rgba(8,8,22,.25);

            border:
                1px solid
                rgba(255,255,255,.13);

            backdrop-filter:
                blur(12px);
        }


        .hero-kicker {

            display: inline-flex;

            padding: 8px 14px;

            border-radius: 999px;

            background:
                rgba(255,255,255,.08);

            border:
                1px solid
                rgba(255,255,255,.15);

            color:
                var(--gold-light);

            font-size: 11px;

            letter-spacing: .18em;

            font-weight: 800;

            text-transform: uppercase;

            margin-bottom: 18px;
        }


        .hero-title {

            font-family:
                "Playfair Display",
                serif;

            font-size:
                clamp(3rem, 7vw, 6.5rem);

            line-height: .95;

            letter-spacing:
                -.045em;

            color: white;

            margin-bottom: 24px;

            text-shadow:
                0 10px 40px
                rgba(0,0,0,.4);
        }


        .hero-title span {

            color:
                #aaa4ff;
        }


        .hero-subtitle {

            max-width: 720px;

            margin:
                0 auto 32px;

            color:
                rgba(255,255,255,.82);

            font-size:
                clamp(1rem, 2vw, 1.2rem);

            line-height: 1.8;
        }


        /* =====================================================
           BUTTONS
           ===================================================== */

        .hero-buttons {

            display: flex;

            justify-content: center;

            flex-wrap: wrap;

            gap: 12px;
        }


        .btn-primary,
        .btn-secondary {

            min-height: 50px;

            padding:
                0 23px;

            border-radius: 16px;

            display: inline-flex;

            align-items: center;

            justify-content: center;

            gap: 9px;

            font-weight: 750;

            cursor: pointer;

            transition:
                transform .2s ease,
                box-shadow .2s ease,
                background .2s ease;

            border: none;
        }


        .btn-primary {

            background:
                var(--primary);

            color: white;

            box-shadow:
                0 12px 40px
                rgba(38,25,176,.45);
        }


        .btn-primary:hover {

            background:
                var(--primary-light);

            transform:
                translateY(-3px);

            box-shadow:
                0 18px 50px
                rgba(70,58,220,.5);
        }


        .btn-secondary {

            color: white;

            background:
                rgba(255,255,255,.08);

            border:
                1px solid
                rgba(255,255,255,.15);
        }


        .btn-secondary:hover {

            background:
                rgba(255,255,255,.14);

            transform:
                translateY(-3px);
        }


        .btn-primary:active,
        .btn-secondary:active {

            transform:
                translateY(1px)
                scale(.98);
        }


        /* =====================================================
           CAROUSEL CONTROLS
           ===================================================== */

        .carousel-controls {

            position: absolute;

            bottom: 28px;

            left: 0;

            right: 0;

            z-index: 20;

            display: flex;

            justify-content: center;

            gap: 8px;
        }


        .carousel-indicator {

            width: 9px;

            height: 9px;

            border-radius: 50%;

            background:
                rgba(255,255,255,.35);

            cursor: pointer;

            transition: .3s ease;
        }


        .carousel-indicator.active {

            width: 30px;

            border-radius: 20px;

            background:
                var(--gold);
        }


        /* =====================================================
           GENERAL SECTION
           ===================================================== */

        .page-section {

            width: min(1120px, calc(100% - 32px));

            margin: auto;

            padding:
                110px 0;
        }


        .section-eyebrow {

            color:
                #aaa4ff;

            font-size: 11px;

            font-weight: 800;

            letter-spacing: .2em;

            text-transform: uppercase;

            text-align: center;

            display: block;

            margin-bottom: 12px;
        }


        .section-title {

            font-family:
                "Playfair Display",
                serif;

            text-align: center;

            font-size:
                clamp(2.3rem, 5vw, 4rem);

            line-height: 1;

            color: white;

            margin-bottom: 18px;

            letter-spacing: -.035em;
        }


        .section-description {

            max-width: 700px;

            margin:
                0 auto 55px;

            text-align: center;

            color:
                var(--text-muted);

            line-height: 1.8;
        }


        /* =====================================================
           SERVICES
           ===================================================== */

        .services-section {

            position: relative;
        }


        .services-grid {

            display: grid;

            grid-template-columns:
                repeat(3, 1fr);

            gap: 18px;
        }


        .card {

            border-radius:
                var(--radius);

            overflow: hidden;

            position: relative;

            background:
                rgba(255,255,255,.045);

            border:
                1px solid
                rgba(255,255,255,.1);

            transition:
                transform .3s ease,
                border .3s ease,
                box-shadow .3s ease;
        }


        .card:hover {

            transform:
                translateY(-8px);

            border-color:
                rgba(255,255,255,.2);

            box-shadow:
                var(--shadow);
        }


        .card-img-wrapper {

            overflow: hidden;

            height: 370px;
        }


        .card-img {

            width: 100%;

            height: 100%;

            object-fit: cover;

            transition:
                transform .6s ease;
        }


        .card:hover .card-img {

            transform:
                scale(1.06);
        }


        .card-content {

            padding: 25px;
        }


        .card-title {

            font-family:
                "Playfair Display",
                serif;

            color: white;

            font-size: 1.6rem;

            margin-bottom: 9px;
        }


        .card-content p {

            color:
                var(--text-muted);

            font-size: .92rem;

            line-height: 1.7;

            margin-bottom: 18px;
        }


        .card-link {

            display: inline-flex;

            align-items: center;

            gap: 7px;

            color:
                #aaa4ff;

            font-weight: 700;

            font-size: .88rem;
        }


        /* =====================================================
           TEAM
           ===================================================== */

        .team-section {

            position: relative;

            padding-top: 80px;
        }


        .team-grid {

            display: grid;

            grid-template-columns:
                repeat(3, 1fr);

            gap: 18px;
        }


        .team-member {

            overflow: hidden;
        }


        .team-image {

            width: 100%;

            height: 410px;

            object-fit: cover;

            transition:
                transform .6s ease;
        }


        .team-member:hover .team-image {

            transform:
                scale(1.04);
        }


        .member-name {

            font-family:
                "Playfair Display",
                serif;

            color: white;

            font-size: 1.55rem;

            margin-bottom: 3px;
        }


        .member-position {

            display: block;

            color:
                var(--gold);

            font-size: .78rem;

            font-weight: 800;

            text-transform: uppercase;

            letter-spacing: .08em;

            margin-bottom: 12px;
        }


        /* =====================================================
           LOCATION
           ===================================================== */

        .locations-section {

            position: relative;
        }


        .location-card {

            display: grid;

            grid-template-columns:
                1.1fr .9fr;

            overflow: hidden;

            border-radius:
                var(--radius);
        }


        .location-info {

            padding: 45px;
        }


        .location-info h3 {

            font-family:
                "Playfair Display",
                serif;

            font-size: 2.5rem;

            margin-bottom: 20px;
        }


        .location-item {

            display: flex;

            gap: 13px;

            align-items: flex-start;

            color:
                var(--text-soft);

            margin-bottom: 14px;
        }


        .location-item i {

            color:
                var(--gold);

            width: 20px;

            margin-top: 5px;
        }


        .location-map {

            min-height: 390px;

            background:
                linear-gradient(
                    135deg,
                    rgba(38,25,176,.8),
                    rgba(10,9,28,.8)
                );

            display: grid;

            place-items: center;

            padding: 30px;
        }


        .map-placeholder {

            width: 100%;

            min-height: 300px;

            border-radius: 24px;

            display: grid;

            place-items: center;

            text-align: center;

            background:
                rgba(255,255,255,.06);

            border:
                1px solid
                rgba(255,255,255,.12);
        }


        .map-placeholder i {

            font-size: 45px;

            color:
                var(--gold);

