    <script>

        /* =====================================================
           CONFIGURAÇÃO
           ===================================================== */

        const DEVITTO_CONFIG = {

            whatsapp:
                "https://wa.me/351927431517",

            phone:
                "+351927431517",

            instagram:
                "https://instagram.com/studiodevitto",

            music:
                "audio/musica-studio-devitto.mp3",

            floatingGif:
                "img/coracao.gif"

        };


        /* =====================================================
           ANO
           ===================================================== */

        document.getElementById("currentYear").textContent =
            new Date().getFullYear();


        /* =====================================================
           MENU MOBILE
           ===================================================== */

        const menuToggle =
            document.getElementById("menuToggle");

        const mainNav =
            document.getElementById("mainNav");

        const mobileOverlay =
            document.getElementById("mobileOverlay");


        function closeMobileMenu() {

            mainNav.classList.remove("active");

            mobileOverlay.classList.remove("active");

            menuToggle.setAttribute(
                "aria-expanded",
                "false"
            );

            menuToggle.innerHTML =
                '<i class="fas fa-bars"></i>';

            document.body.style.overflow =
                "";
        }


        menuToggle.addEventListener(
            "click",
            function () {

                const isOpen =
                    mainNav.classList.toggle("active");

                mobileOverlay.classList.toggle(
                    "active",
                    isOpen
                );

                this.setAttribute(
                    "aria-expanded",
                    isOpen
                );

                this.innerHTML = isOpen
                    ? '<i class="fas fa-xmark"></i>'
                    : '<i class="fas fa-bars"></i>';

                document.body.style.overflow =
                    isOpen ? "hidden" : "";

            }
        );


        mobileOverlay.addEventListener(
            "click",
            closeMobileMenu
        );


        document.querySelectorAll(".nav-link")
            .forEach(function (link) {

                link.addEventListener(
                    "click",
                    closeMobileMenu
                );

            });


        /* =====================================================
           CARROSSEL
           ===================================================== */

        const carouselItems =
            document.querySelectorAll(
                ".carousel-item"
            );

        const indicators =
            document.querySelectorAll(
                ".carousel-indicator"
            );

        let currentSlide = 0;

        let carouselTimer;


        function showSlide(index) {

            carouselItems.forEach(
                function (slide) {

                    slide.classList.remove(
                        "active"
                    );

                }
            );


            indicators.forEach(
                function (indicator) {

                    indicator.classList.remove(
                        "active"
                    );

                }
            );


            carouselItems[index]
                .classList.add("active");

            indicators[index]
                .classList.add("active");

            currentSlide = index;

        }


        function nextSlide() {

            const next =
                (currentSlide + 1)
                % carouselItems.length;

            showSlide(next);

        }


        function startCarousel() {

            clearInterval(
                carouselTimer
            );

            carouselTimer =
                setInterval(
                    nextSlide,
                    5500
                );

        }


        function stopCarousel() {

            clearInterval(
                carouselTimer
            );

        }


        indicators.forEach(
            function (indicator) {

                indicator.addEventListener(
                    "click",
                    function () {

                        const index =
                            Number(
                                this.dataset.index
                            );

                        showSlide(index);

                        startCarousel();

                    }
                );

            }
        );


        const carousel =
            document.querySelector(".carousel");


        carousel.addEventListener(
            "mouseenter",
            stopCarousel
        );


        carousel.addEventListener(
            "mouseleave",
            startCarousel
        );


        showSlide(0);

        startCarousel();


        /* =====================================================
           PLAYER DE MÚSICA
           
           IMPORTANTE:

           O navegador pode bloquear autoplay
           com som antes de uma interação do utilizador.

           Por isso tentamos autoplay e, se o navegador
           bloquear, o botão fica disponível.

           Para manter a música entre páginas,
           a versão final deve usar navegação SPA/
           partial navigation.
           ===================================================== */

        const music =
            document.getElementById(
                "backgroundMusic"
            );

        const musicToggle =
            document.getElementById(
                "musicToggle"
            );

        const musicProgress =
            document.getElementById(
                "musicProgress"
            );


        music.volume = 0.30;


        function updateMusicButton() {

            musicToggle.innerHTML =
                music.paused

                    ? '<i class="fas fa-play"></i>'

                    : '<i class="fas fa-pause"></i>';

        }


        music.addEventListener(
            "play",
            updateMusicButton
        );


        music.addEventListener(
            "pause",
            updateMusicButton
        );


        musicToggle.addEventListener(
            "click",
            async function () {

                try {

                    if (music.paused) {

                        await music.play();

                    } else {

                        music.pause();

                    }

                } catch (error) {

                    console.warn(
                        "O navegador bloqueou o autoplay.",
                        error
                    );

                }

                updateMusicButton();

            }
        );


        music.addEventListener(
            "timeupdate",
            function () {

                if (
                    music.duration &&
                    Number.isFinite(
                        music.duration
                    )
                ) {

                    musicProgress.value =
                        (
                            music.currentTime /
                            music.duration
                        ) * 100;

                }

            }
        );


        musicProgress.addEventListener(
            "input",
            function () {

                if (
                    music.duration &&
                    Number.isFinite(
                        music.duration
                    )
                ) {

                    music.currentTime =
                        (
                            Number(
                                this.value
                            ) / 100
                        ) *
                        music.duration;

                }

            }
        );


        /*
         * Guardamos o estado do player.
         */

        function saveMusicState() {

            try {

                sessionStorage.setItem(
                    "devitto_music_state",
                    JSON.stringify({

                        currentTime:
                            music.currentTime,

                        volume:
                            music.volume,

                        playing:
                            !music.paused

                    })
                );

            } catch (error) {

                console.warn(
                    "Não foi possível guardar o estado do player."
                );

            }

        }


        function restoreMusicState() {

            try {

                const state =
                    JSON.parse(
                        sessionStorage.getItem(
                            "devitto_music_state"
                        ) || "null"
                    );


                if (!state) {

                    return;

                }


                if (
                    typeof state.volume ===
                    "number"
                ) {

                    music.volume =
                        state.volume;

                }


                if (
                    typeof state.currentTime ===
                    "number"
                ) {

                    music.addEventListener(
                        "loadedmetadata",
                        function () {

                            try {

                                music.currentTime =
                                    state.currentTime;

                            } catch (error) {}

                        },
                        { once: true }
                    );

                }

            } catch (error) {}

        }


        restoreMusicState();


        window.addEventListener(
            "beforeunload",
            saveMusicState
        );


        /*
         * Tentativa de autoplay.
         *
         * Alguns navegadores não permitem
         * reprodução automática com som.
         */

        music.play()
            .then(function () {

                updateMusicButton();

            })
            .catch(function () {

                updateMusicButton();

            });


        /* =====================================================
           MENU FLUTUANTE
           ===================================================== */

        const floatingMenuButton =
            document.getElementById(
                "floatingMenuButton"
            );

        const menuItems =
            document.getElementById(
                "menuItems"
            );


        floatingMenuButton.addEventListener(
            "click",
            function () {

                const active =
                    this.classList.toggle(
                        "active"
                    );

                menuItems.classList.toggle(
                    "active",
                    active
                );

                this.setAttribute(
                    "aria-expanded",
                    active
                );

            }
        );


        document.addEventListener(
            "click",
            function (event) {

                if (
                    !event.target.closest(
                        ".floating-menu"
                    )
                ) {

                    floatingMenuButton
                        .classList
                        .remove("active");

                    menuItems
                        .classList
                        .remove("active");

                    floatingMenuButton
                        .setAttribute(
                            "aria-expanded",
                            "false"
                        );

                }

            }
        );


        /* =====================================================
           CONTACTO POPUP
           ===================================================== */

        const contactPopup =
            document.getElementById(
                "contactPopup"
            );

        const popupClose =
            document.getElementById(
                "popupClose"
            );

        const whatsappBtn =
            document.getElementById(
                "whatsappBtn"
            );

        const callBtn =
            document.getElementById(
                "callBtn"
            );


        function openContactPopup() {

            contactPopup.classList.add(
                "active"
            );

            document.body.style.overflow =
                "hidden";

        }


        function closeContactPopup() {

            contactPopup.classList.remove(
                "active"
            );

            document.body.style.overflow =
                "";

        }


        whatsappBtn.addEventListener(
            "click",
            openContactPopup
        );


        callBtn.addEventListener(
            "click",
            openContactPopup
        );


        popupClose.addEventListener(
            "click",
            closeContactPopup
        );


        contactPopup.addEventListener(
            "click",
            function (event) {

                if (
                    event.target ===
                    contactPopup
                ) {

                    closeContactPopup();

                }

            }
        );


        /* =====================================================
           WELCOME POPUP
           ===================================================== */

        const welcomePopup =
            document.getElementById(
                "welcomePopup"
            );

        const welcomeClose =
            document.getElementById(
                "welcomeClose"
            );


        const popupStorageKey =
            "devitto_welcome_popup_seen";


        function closeWelcomePopup() {

            welcomePopup.classList.remove(
                "active"
            );

            document.body.style.overflow =
                "";

        }


        welcomeClose.addEventListener(
            "click",
            closeWelcomePopup
        );


        welcomePopup.addEventListener(
            "click",
            function (event) {

                if (
                    event.target ===
                    welcomePopup
                ) {

                    closeWelcomePopup();

                }

            }
        );


        /*
         * Mostrar apenas uma vez por navegador.
         */

        if (
            !localStorage.getItem(
                popupStorageKey
            )
        ) {

            setTimeout(
                function () {

                    welcomePopup.classList.add(
                        "active"
                    );

                    localStorage.setItem(
                        popupStorageKey,
                        "true"
                    );

                },
                2500
            );

        }


        /* =====================================================
           ESC FECHA POPUPS E MENU
           ===================================================== */

        document.addEventListener(
            "keydown",
            function (event) {

                if (
                    event.key !== "Escape"
                ) {

                    return;

                }


                closeMobileMenu();

                closeContactPopup();

                closeWelcomePopup();

            }
        );


        /* =====================================================
           BACK TO TOP
           ===================================================== */

        const backToTop =
            document.getElementById(
                "backToTop"
            );


        window.addEventListener(
            "scroll",
            function () {

                if (
                    window.scrollY > 450
                ) {

                    backToTop.classList.add(
                        "visible"
                    );

                } else {

                    backToTop.classList.remove(
                        "visible"
                    );

                }

            },
            { passive: true }
        );


        backToTop.addEventListener(
            "click",
            function () {

                window.scrollTo({

                    top: 0,

                    behavior: "smooth"

                });

            }
        );


        /* =====================================================
           CORAÇÕES/GIF FLUTUANTE DECORATIVO
           ===================================================== */

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const container =
                    document.getElementById(
                        "sardinhasContainer"
                    );


                if (!container) {

                    return;

                }


                /*
                 * Em dispositivos móveis reduzimos
                 * a quantidade para melhorar performance.
                 */

                let count = 5;


                if (
                    window.innerWidth >= 768
                ) {

                    count = 10;

                }


                if (
                    window.innerWidth >= 1200
                ) {

                    count = 15;

                }


                for (
                    let i = 0;
                    i < count;
                    i++
                ) {

                    const item =
                        document.createElement(
                            "img"
                        );


                    item.src =
                        "img/coracao.gif";


                    item.alt =
                        "";


                    item.setAttribute(
                        "aria-hidden",
                        "true"
                    );


                    item.style.position =
                        "fixed";

                    item.style.left =
                        Math.random() *
                        100 +
                        "vw";

                    item.style.top =
                        Math.random() *
                        100 +
                        "vh";

                    item.style.width =
                        25 +
                        Math.random() *
                        45 +
                        "px";

                    item.style.opacity =
                        "0.18";

                    item.style.pointerEvents =
                        "none";

                    item.style.zIndex =
                        "1";

                    item.style.animation =
                        "devittoHeartFloat " +
                        (
                            12 +
                            Math.random() * 18
                        ) +
                        "s linear infinite";


                    container.appendChild(
                        item
                    );

                }

            }
        );


        /* =====================================================
           ANIMAÇÃO DECORATIVA
           ===================================================== */

        const decorativeStyle =
            document.createElement(
                "style"
            );


        decorativeStyle.innerHTML = `

            @keyframes devittoHeartFloat {

                0% {
                    transform:
                        translate3d(
                            -40px,
                            40px,
                            0
                        )
                        rotate(0deg);

                    opacity:0;
                }

                15% {
                    opacity:.18;
                }

                80% {
                    opacity:.18;
                }

                100% {
                    transform:
                        translate3d(
                            40vw,
                            -110vh,
                            0
                        )
                        rotate(360deg);

                    opacity:0;
                }

            }

        `;


        document.head.appendChild(
            decorativeStyle
        );


        /* =====================================================
           TRACKING DE CLIQUES
           
           Preparado para GA4.
           ===================================================== */

        document.querySelectorAll(
            'a[href*="wa.me"]'
        ).forEach(
            function (link) {

                link.addEventListener(
                    "click",
                    function () {

                        if (
                            typeof gtag ===
                            "function"
                        ) {

                            gtag(
                                "event",
                                "whatsapp_click",
                                {
                                    event_category:
                                        "contact",

                                    event_label:
                                        "Studio DeVitto WhatsApp"
                                }
                            );

                        }

                    }
                );

            }
        );


        document.querySelectorAll(
            'a[href^="tel:"]'
        ).forEach(
            function (link) {

                link.addEventListener(
                    "click",
                    function () {

                        if (
                            typeof gtag ===
                            "function"
                        ) {

                            gtag(
                                "event",
                                "phone_click",
                                {
                                    event_category:
                                        "contact",

                                    event_label:
                                        "Studio DeVitto telefone"
                                }
                            );

                        }

                    }
                );

            }
        );


        document.querySelectorAll(
            'a[href*="agendamento"]'
        ).forEach(
            function (link) {

                link.addEventListener(
                    "click",
                    function () {

                        if (
                            typeof gtag ===
                            "function"
                        ) {

                            gtag(
                                "event",
                                "booking_click",
                                {
                                    event_category:
                                        "booking",

                                    event_label:
                                        "Agendamento Studio DeVitto"
                                }
                            );

                        }

                    }
                );

            }
        );


    </script>


