<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title>Dashboard - Studio DeVitto</title>
    
    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <!-- Firebase -->
    <script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-app.js"></script>
    <script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-auth.js"></script>
    <script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-firestore.js"></script>
    
    <style>
        /* ============================================
           VARIÁVEIS E ESTILOS GERAIS
           ============================================ */
        :root {
            --primary-color: #26196b;
            --secondary-color: #ffd700;
            --accent-color: #4a3a9c;
            --light-bg: #f8f9fa;
            --card-radius: 12px;
            --shadow-sm: 0 2px 8px rgba(0,0,0,0.08);
            --shadow-md: 0 4px 16px rgba(0,0,0,0.12);
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: var(--light-bg);
            min-height: 100vh;
            padding: 20px;
        }

        .dashboard-container {
            max-width: 1400px;
            margin: 0 auto;
        }

        /* ============================================
           CABEÇALHO
           ============================================ */
        .dashboard-header {
            background: linear-gradient(135deg, var(--primary-color), var(--accent-color));
            color: white;
            padding: 20px 25px;
            border-radius: var(--card-radius);
            margin-bottom: 24px;
            box-shadow: var(--shadow-md);
        }

        .dashboard-header h1 {
            font-weight: 700;
            font-size: 1.6rem;
            margin: 0;
        }

        .dashboard-header h1 i {
            color: var(--secondary-color);
        }

        .dashboard-header .subtitle {
            opacity: 0.8;
            font-size: 0.9rem;
            margin: 4px 0 0;
        }

        .dashboard-header .header-actions {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            margin-top: 10px;
        }

        .dashboard-header .btn-refresh {
            background: rgba(255,255,255,0.15);
            border: 1px solid rgba(255,255,255,0.25);
            color: white;
            border-radius: 20px;
            padding: 6px 16px;
            font-size: 0.85rem;
            transition: all 0.3s;
            cursor: pointer;
        }

        .dashboard-header .btn-refresh:hover {
            background: rgba(255,255,255,0.25);
        }

        /* ============================================
           CARDS DE MÉTRICAS
           ============================================ */
        .metric-card {
            background: white;
            border-radius: var(--card-radius);
            padding: 18px 20px;
            box-shadow: var(--shadow-sm);
            transition: all 0.3s ease;
            height: 100%;
            border-left: 4px solid var(--primary-color);
        }

        .metric-card:hover {
            transform: translateY(-3px);
            box-shadow: var(--shadow-md);
        }

        .metric-card .metric-icon {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            color: white;
            flex-shrink: 0;
        }

        .metric-card .metric-icon.purple { background: var(--primary-color); }
        .metric-card .metric-icon.green { background: #28a745; }
        .metric-card .metric-icon.blue { background: #17a2b8; }
        .metric-card .metric-icon.gold { background: #ffc107; }
        .metric-card .metric-icon.red { background: #dc3545; }
        .metric-card .metric-icon.orange { background: #fd7e14; }
        .metric-card .metric-icon.pink { background: #e83e8c; }

        .metric-card .metric-label {
            font-size: 0.8rem;
            color: #6c757d;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

        .metric-card .metric-value {
            font-size: 1.8rem;
            font-weight: 700;
            color: #2d2d2d;
            line-height: 1.2;
        }

        .metric-card .metric-value .currency {
            font-size: 1rem;
            color: #6c757d;
        }

        .metric-card .metric-sub {
            font-size: 0.75rem;
            color: #adb5bd;
            margin-top: 2px;
        }

        /* ============================================
           CARDS DE DESEMPENHO DOS FUNCIONÁRIOS
           ============================================ */
        .funcionario-card {
            background: white;
            border-radius: var(--card-radius);
            overflow: hidden;
            box-shadow: var(--shadow-sm);
            transition: all 0.3s ease;
            height: 100%;
        }

        .funcionario-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-md);
        }

        .funcionario-card .card-header-custom {
            padding: 14px 16px;
            color: white;
            text-align: center;
            background: linear-gradient(135deg, var(--primary-color), var(--accent-color));
        }

        .funcionario-card .card-header-custom .avatar {
            width: 56px;
            height: 56px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid rgba(255,255,255,0.4);
            margin-bottom: 6px;
        }

        .funcionario-card .card-header-custom .avatar-placeholder {
            width: 56px;
            height: 56px;
            border-radius: 50%;
            background: rgba(255,255,255,0.2);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            font-weight: bold;
            margin: 0 auto 6px;
            border: 3px solid rgba(255,255,255,0.3);
        }

        .funcionario-card .card-header-custom h6 {
            margin: 0;
            font-weight: 600;
            font-size: 0.95rem;
        }

        .funcionario-card .card-header-custom small {
            opacity: 0.8;
            font-size: 0.7rem;
        }

        .funcionario-card .card-body-custom {
            padding: 12px 14px;
        }

        .funcionario-card .stat-row {
            display: flex;
            justify-content: space-between;
            padding: 4px 0;
            font-size: 0.8rem;
            border-bottom: 1px solid #f0f0f0;
        }

        .funcionario-card .stat-row:last-child {
            border-bottom: none;
        }

        .funcionario-card .stat-row .label {
            color: #6c757d;
        }

        .funcionario-card .stat-row .value {
            font-weight: 600;
        }

        .funcionario-card .stat-row .value.positive { color: #28a745; }
        .funcionario-card .stat-row .value.negative { color: #dc3545; }

        .funcionario-card .progress-custom {
            height: 4px;
            background: #e9ecef;
            border-radius: 4px;
            margin-top: 8px;
            overflow: hidden;
        }

        .funcionario-card .progress-custom .bar {
            height: 100%;
            border-radius: 4px;
            transition: width 0.6s ease;
        }

        .funcionario-card .progress-custom .bar.salao { background: var(--primary-color); }
        .funcionario-card .progress-custom .bar.comissao { background: var(--secondary-color); }

        /* ============================================
           SEÇÃO DE ANIVERSÁRIOS
           ============================================ */
        .birthday-list {
            max-height: 300px;
            overflow-y: auto;
        }

        .birthday-item {
            display: flex;
            align-items: center;
            padding: 10px 12px;
            border-bottom: 1px solid #f0f0f0;
            transition: background 0.2s;
            cursor: pointer;
        }

        .birthday-item:hover {
            background: #f8f9fa;
        }

        .birthday-item .avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            object-fit: cover;
            margin-right: 12px;
            flex-shrink: 0;
        }

        .birthday-item .avatar-placeholder {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: var(--primary-color);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 16px;
            margin-right: 12px;
            flex-shrink: 0;
        }

        .birthday-item .info {
            flex: 1;
            min-width: 0;
        }

        .birthday-item .info .name {
            font-weight: 600;
            font-size: 0.9rem;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .birthday-item .info .date {
            font-size: 0.75rem;
            color: #6c757d;
        }

        .birthday-item .badge-today {
            background: #dc3545;
            color: white;
            font-size: 0.65rem;
            padding: 2px 10px;
            border-radius: 12px;
            font-weight: 600;
            animation: pulse-badge 1.5s infinite;
        }

        .birthday-item .badge-soon {
            background: #ffc107;
            color: #000;
            font-size: 0.65rem;
            padding: 2px 10px;
            border-radius: 12px;
            font-weight: 600;
        }

        @keyframes pulse-badge {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.05); }
        }

        /* ============================================
           SERVIÇOS RECENTES
           ============================================ */
        .recent-service-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 8px 0;
            border-bottom: 1px solid #f0f0f0;
        }

        .recent-service-item:last-child {
            border-bottom: none;
        }

        .recent-service-item .service-info {
            flex: 1;
            min-width: 0;
        }

        .recent-service-item .service-info .name {
            font-weight: 500;
            font-size: 0.85rem;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .recent-service-item .service-info .client {
            font-size: 0.75rem;
            color: #6c757d;
        }

        .recent-service-item .service-value {
            font-weight: 600;
            color: var(--primary-color);
            font-size: 0.9rem;
            margin-left: 10px;
            flex-shrink: 0;
        }

        /* ============================================
           ALERTAS DE ESTOQUE BAIXO
           ============================================ */
        .stock-alert-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 8px 12px;
            background: #fff3cd;
            border-radius: 8px;
            margin-bottom: 6px;
            border-left: 3px solid #ffc107;
        }

        .stock-alert-item .product-name {
            font-weight: 500;
            font-size: 0.85rem;
        }

        .stock-alert-item .stock-qty {
            font-size: 0.75rem;
            color: #856404;
            font-weight: 600;
        }

        /* ============================================
           GRÁFICO
           ============================================ */
        .chart-container {
            background: white;
            border-radius: var(--card-radius);
            padding: 20px;
            box-shadow: var(--shadow-sm);
            height: 300px;
            position: relative;
        }

        .chart-container h6 {
            color: var(--primary-color);
            font-weight: 600;
            margin-bottom: 12px;
        }

        /* ============================================
           EMPRESA CARD (Visão Geral)
           ============================================ */
        .empresa-card {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: var(--card-radius);
            padding: 20px 24px;
            color: white;
            box-shadow: var(--shadow-md);
            margin-bottom: 20px;
        }

        .empresa-card .empresa-title {
            font-size: 1.1rem;
            font-weight: 600;
            margin-bottom: 12px;
        }

        .empresa-card .empresa-stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
            gap: 12px;
        }

        .empresa-card .empresa-stat {
            background: rgba(255,255,255,0.12);
            border-radius: 10px;
            padding: 12px 14px;
            text-align: center;
        }

        .empresa-card .empresa-stat .stat-value {
            font-size: 1.4rem;
            font-weight: 700;
        }

        .empresa-card .empresa-stat .stat-label {
            font-size: 0.7rem;
            opacity: 0.8;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

        /* ============================================
           RESPONSIVIDADE
           ============================================ */
        @media (max-width: 768px) {
            body { padding: 10px; }
            
            .dashboard-header {
                padding: 16px 18px;
            }
            .dashboard-header h1 {
                font-size: 1.2rem;
            }

            .metric-card .metric-value {
                font-size: 1.3rem;
            }
            .metric-card .metric-icon {
                width: 36px;
                height: 36px;
                font-size: 1rem;
            }

            .chart-container {
                height: 220px;
                padding: 14px;
            }

            .empresa-card .empresa-stats {
                grid-template-columns: repeat(2, 1fr);
            }

            .funcionario-card .card-header-custom .avatar,
            .funcionario-card .card-header-custom .avatar-placeholder {
                width: 44px;
                height: 44px;
                font-size: 18px;
            }
            .funcionario-card .card-header-custom h6 {
                font-size: 0.8rem;
            }
        }

        @media (max-width: 480px) {
            .metric-card {
                padding: 12px 14px;
            }
            .metric-card .metric-value {
                font-size: 1.1rem;
            }
            .metric-card .metric-label {
                font-size: 0.65rem;
            }
            .empresa-card .empresa-stat .stat-value {
                font-size: 1.1rem;
            }
            .dashboard-header .header-actions {
                flex-direction: column;
                align-items: stretch;
            }
        }

        /* ============================================
           SCROLLBAR
           ============================================ */
        ::-webkit-scrollbar { width: 5px; height: 5px; }
        ::-webkit-scrollbar-track { background: #f1f1f1; border-radius: 4px; }
        ::-webkit-scrollbar-thumb { background: #c1c1c1; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #a8a8a8; }

        /* ============================================
           UTILITÁRIOS
           ============================================ */
        .text-truncate-2 {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .cursor-pointer { cursor: pointer; }
        .gap-2 { gap: 8px; }
        .gap-3 { gap: 12px; }
        .gap-4 { gap: 16px; }
        .flex-wrap { flex-wrap: wrap; }
        .align-center { align-items: center; }
        .justify-between { justify-content: space-between; }
        .mt-2 { margin-top: 8px; }
        .mt-3 { margin-top: 16px; }
        .mt-4 { margin-top: 24px; }
        .mb-2 { margin-bottom: 8px; }
        .mb-3 { margin-bottom: 16px; }
        .mb-4 { margin-bottom: 24px; }
        .text-muted { color: #6c757d; }
        .text-success { color: #28a745; }
        .text-danger { color: #dc3545; }
        .text-warning { color: #ffc107; }
        .text-primary { color: var(--primary-color); }
        .fw-bold { font-weight: 700; }
        .fw-semibold { font-weight: 600; }
        .fs-small { font-size: 0.8rem; }
        .fs-large { font-size: 1.2rem; }
    </style>
</head>
<body>

<div class="dashboard-container" id="dashboardApp">

    <!-- ==========================================
    CABEÇALHO
    ========================================== -->
    <div class="dashboard-header">
        <div class="d-flex flex-wrap justify-content-between align-center">
            <div>
                <h1><i class="fas fa-tachometer-alt me-2"></i>Dashboard</h1>
                <p class="subtitle" id="dashboardSubtitle">Visão geral do seu negócio</p>
            </div>
            <div class="header-actions">
                <span class="badge bg-light text-dark px-3 py-2" id="lastUpdateBadge">
                    <i class="fas fa-clock me-1"></i>Atualizado agora
                </span>
                <button class="btn-refresh" onclick="refreshDashboard()">
                    <i class="fas fa-sync-alt me-1"></i>Atualizar
                </button>
            </div>
        </div>
    </div>

    <!-- ==========================================
    CARDS DE MÉTRICAS PRINCIPAIS
    ========================================== -->
    <div class="row g-3 mb-4" id="metricsRow">
        <!-- Caixa Atual -->
        <div class="col-lg-3 col-md-6 col-12">
            <div class="metric-card">
                <div class="d-flex justify-content-between align-center">
                    <div>
                        <div class="metric-label">Caixa Atual</div>
                        <div class="metric-value" id="currentCash">€ 0,00</div>
                        <div class="metric-sub" id="cashierStatus">Caixa fechado</div>
                    </div>
                    <div class="metric-icon purple"><i class="fas fa-cash-register"></i></div>
                </div>
            </div>
        </div>

        <!-- Vendas Hoje -->
        <div class="col-lg-3 col-md-6 col-12">
            <div class="metric-card" style="border-left-color: #28a745;">
                <div class="d-flex justify-content-between align-center">
                    <div>
                        <div class="metric-label">Vendas Hoje</div>
                        <div class="metric-value text-success" id="todaySales">€ 0,00</div>
                        <div class="metric-sub" id="todayServices">0 serviços</div>
                    </div>
                    <div class="metric-icon green"><i class="fas fa-calendar-day"></i></div>
                </div>
            </div>
        </div>

        <!-- Vendas Semana -->
        <div class="col-lg-3 col-md-6 col-12">
            <div class="metric-card" style="border-left-color: #ffc107;">
                <div class="d-flex justify-content-between align-center">
                    <div>
                        <div class="metric-label">Vendas Semana</div>
                        <div class="metric-value text-warning" id="weekSales">€ 0,00</div>
                        <div class="metric-sub" id="weekServices">0 serviços</div>
                    </div>
                    <div class="metric-icon gold"><i class="fas fa-calendar-week"></i></div>
                </div>
            </div>
        </div>

        <!-- Vendas Mês -->
        <div class="col-lg-3 col-md-6 col-12">
            <div class="metric-card" style="border-left-color: #17a2b8;">
                <div class="d-flex justify-content-between align-center">
                    <div>
                        <div class="metric-label">Vendas Mês</div>
                        <div class="metric-value text-info" id="monthSales">€ 0,00</div>
                        <div class="metric-sub" id="monthServices">0 serviços</div>
                    </div>
                    <div class="metric-icon blue"><i class="fas fa-calendar-alt"></i></div>
                </div>
            </div>
        </div>
    </div>

    <!-- ==========================================
    SEGUNDA LINHA DE MÉTRICAS
    ========================================== -->
    <div class="row g-3 mb-4">
        <!-- Produtos Vendidos Hoje -->
        <div class="col-lg-3 col-md-6 col-12">
            <div class="metric-card" style="border-left-color: #17a2b8;">
                <div class="d-flex justify-content-between align-center">
                    <div>
                        <div class="metric-label">Produtos Hoje</div>
                        <div class="metric-value text-info" id="todayProducts">€ 0,00</div>
                        <div class="metric-sub" id="todayProductsCount">0 produtos</div>
                    </div>
                    <div class="metric-icon blue"><i class="fas fa-shopping-bag"></i></div>
                </div>
            </div>
        </div>

        <!-- Colaboradores -->
        <div class="col-lg-3 col-md-6 col-12">
            <div class="metric-card" style="border-left-color: var(--primary-color);">
                <div class="d-flex justify-content-between align-center">
                    <div>
                        <div class="metric-label">Colaboradores</div>
                        <div class="metric-value" id="totalCollaborators">0</div>
                        <div class="metric-sub">Ativos</div>
                    </div>
                    <div class="metric-icon purple"><i class="fas fa-user-friends"></i></div>
                </div>
            </div>
        </div>

        <!-- Clientes -->
        <div class="col-lg-3 col-md-6 col-12">
            <div class="metric-card" style="border-left-color: #28a745;">
                <div class="d-flex justify-content-between align-center">
                    <div>
                        <div class="metric-label">Clientes</div>
                        <div class="metric-value text-success" id="totalClients">0</div>
                        <div class="metric-sub">Cadastrados</div>
                    </div>
                    <div class="metric-icon green"><i class="fas fa-users"></i></div>
                </div>
            </div>
        </div>

        <!-- Aniversários -->
        <div class="col-lg-3 col-md-6 col-12">
            <div class="metric-card" style="border-left-color: #dc3545;">
                <div class="d-flex justify-content-between align-center">
                    <div>
                        <div class="metric-label">Aniversários</div>
                        <div class="metric-value text-danger" id="upcomingBirthdays">0</div>
                        <div class="metric-sub">Próximos 7 dias</div>
                    </div>
                    <div class="metric-icon red"><i class="fas fa-birthday-cake"></i></div>
                </div>
            </div>
        </div>
    </div>

    <!-- ==========================================
    EMPRESA - VISÃO GERAL
    ========================================== -->
    <div class="empresa-card" id="empresaCard">
        <div class="empresa-title">
            <i class="fas fa-building me-2"></i>Visão Geral da Empresa
        </div>
        <div class="empresa-stats" id="empresaStats">
            <div class="empresa-stat">
                <div class="stat-value" id="empresaFaturamento">€ 0,00</div>
                <div class="stat-label">Faturamento Total</div>
            </div>
            <div class="empresa-stat">
                <div class="stat-value" id="empresaLucro">€ 0,00</div>
                <div class="stat-label">Lucro Líquido</div>
            </div>
            <div class="empresa-stat">
                <div class="stat-value" id="empresaComissoes">€ 0,00</div>
                <div class="stat-label">Comissões Pagas</div>
            </div>
            <div class="empresa-stat">
                <div class="stat-value" id="empresaTicket">€ 0,00</div>
                <div class="stat-label">Ticket Médio</div>
            </div>
        </div>
    </div>

    <!-- ==========================================
    GRÁFICO E SERVIÇOS RECENTES
    ========================================== -->
    <div class="row g-3 mb-4">
        <!-- Gráfico -->
        <div class="col-lg-8 col-md-12">
            <div class="chart-container">
                <h6><i class="fas fa-chart-bar me-2"></i>Vendas Mensais - Serviços vs Produtos</h6>
                <canvas id="monthlySalesChart"></canvas>
            </div>
        </div>

        <!-- Serviços Recentes -->
        <div class="col-lg-4 col-md-12">
            <div class="card-custom" style="background:white;border-radius:var(--card-radius);padding:16px;box-shadow:var(--shadow-sm);height:100%;">
                <h6 class="fw-bold text-primary mb-3"><i class="fas fa-clock me-2"></i>Serviços Recentes</h6>
                <div id="recentServicesList" style="max-height:230px;overflow-y:auto;">
