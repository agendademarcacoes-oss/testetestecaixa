<script>
    // ==========================================
    // 1. CONFIGURAÇÃO DO FIREBASE
    // ==========================================
    const firebaseConfig = {
        apiKey: "AIzaSyC5ezGCOS5d-Vy2l-Gimkl_V9VmwDLZzKc",
        authDomain: "studio-devitto-152400.firebaseapp.com",
        projectId: "studio-devitto-152400",
        storageBucket: "studio-devitto-152400.appspot.com",
        messagingSenderId: "138996544906",
        appId: "1:138996544906:web:6569bf954a00e2f7944473",
        measurementId: "G-FCC5T13QW8"
    };

    firebase.initializeApp(firebaseConfig);
    const auth = firebase.auth();
    const db = firebase.firestore();

    // ==========================================
    // 2. VARIÁVEIS GLOBAIS
    // ==========================================
    let currentUser = null;
    let allServices = [];
    let allProductSales = [];
    let clients = [];
    let collaborators = [];
    let products = [];
    let appointments = [];
    let currentCashier = null;
    let todayServices = [];
    let todayProductSales = [];
    let myChart = null;

    // ==========================================
    // 3. INICIALIZAÇÃO
    // ==========================================
    document.addEventListener('DOMContentLoaded', function() {
        auth.onAuthStateChanged(user => {
            if (user) {
                currentUser = user;
                document.getElementById('dashboardSubtitle').textContent = 
                    `Bem-vindo(a), ${user.email}`;
                loadAllData();
            } else {
                document.getElementById('dashboardSubtitle').textContent = 
                    'Faça login para visualizar o dashboard';
                showLoginPrompt();
            }
        });
    });

    // ==========================================
    // 4. CARREGAR TODOS OS DADOS
    // ==========================================
    async function loadAllData() {
        try {
            await Promise.all([
                loadServices(),
                loadProductSales(),
                loadClients(),
                loadCollaborators(),
                loadProducts(),
                loadAppointments(),
                loadCashierStatus()
            ]);
            updateDashboard();
            updateLastUpdate();
        } catch (error) {
            console.error('Erro ao carregar dados:', error);
            // Tentar carregar do localStorage
            loadFromLocalStorage();
        }
    }

    // ==========================================
    // 5. FUNÇÕES DE CARREGAMENTO
    // ==========================================
    function loadServices() {
        return new Promise((resolve) => {
            if (!currentUser) { resolve(); return; }
            db.collection('services')
                .where('userId', '==', currentUser.uid)
                .get()
                .then(snapshot => {
                    allServices = [];
                    snapshot.forEach(doc => {
                        allServices.push({ id: doc.id, ...doc.data() });
                    });
                    const today = new Date().toISOString().split('T')[0];
                    todayServices = allServices.filter(s => s.date === today);
                    saveToLocalStorage('services', allServices);
                    resolve();
                })
                .catch(() => resolve());
        });
    }

    function loadProductSales() {
        return new Promise((resolve) => {
            if (!currentUser) { resolve(); return; }
            db.collection('productSales')
                .where('userId', '==', currentUser.uid)
                .get()
                .then(snapshot => {
                    allProductSales = [];
                    snapshot.forEach(doc => {
                        allProductSales.push({ id: doc.id, ...doc.data() });
                    });
                    const today = new Date().toISOString().split('T')[0];
                    todayProductSales = allProductSales.filter(s => s.date === today);
                    saveToLocalStorage('productSales', allProductSales);
                    resolve();
                })
                .catch(() => resolve());
        });
    }

    function loadClients() {
        return new Promise((resolve) => {
            if (!currentUser) { resolve(); return; }
            db.collection('clients')
                .where('userId', '==', currentUser.uid)
                .get()
                .then(snapshot => {
                    clients = [];
                    snapshot.forEach(doc => {
                        clients.push({ id: doc.id, ...doc.data() });
                    });
                    clients.sort((a, b) => (a.name || '').localeCompare(b.name || ''));
                    saveToLocalStorage('clients', clients);
                    resolve();
                })
                .catch(() => resolve());
        });
    }

    function loadCollaborators() {
        return new Promise((resolve) => {
            if (!currentUser) { resolve(); return; }
            db.collection('collaborators')
                .where('userId', '==', currentUser.uid)
                .get()
                .then(snapshot => {
                    collaborators = [];
                    snapshot.forEach(doc => {
                        collaborators.push({ id: doc.id, ...doc.data() });
                    });
                    saveToLocalStorage('collaborators', collaborators);
                    resolve();
                })
                .catch(() => resolve());
        });
    }

    function loadProducts() {
        return new Promise((resolve) => {
            if (!currentUser) { resolve(); return; }
            db.collection('products')
                .where('userId', '==', currentUser.uid)
                .get()
                .then(snapshot => {
                    products = [];
                    snapshot.forEach(doc => {
                        products.push({ id: doc.id, ...doc.data() });
                    });
                    saveToLocalStorage('products', products);
                    resolve();
                })
                .catch(() => resolve());
        });
    }

    function loadAppointments() {
        return new Promise((resolve) => {
            if (!currentUser) { resolve(); return; }
            db.collection('appointments')
                .where('userId', '==', currentUser.uid)
                .get()
                .then(snapshot => {
                    appointments = [];
                    snapshot.forEach(doc => {
                        appointments.push({ id: doc.id, ...doc.data() });
                    });
                    saveToLocalStorage('appointments', appointments);
                    resolve();
                })
                .catch(() => resolve());
        });
    }

    function loadCashierStatus() {
        return new Promise((resolve) => {
            if (!currentUser) { resolve(); return; }
            const today = new Date().toISOString().split('T')[0];
            db.collection('cashiers')
                .where('date', '==', today)
                .where('userId', '==', currentUser.uid)
                .where('status', '==', 'open')
                .get()
                .then(snapshot => {
                    if (!snapshot.empty) {
                        currentCashier = snapshot.docs[0].data();
                        currentCashier.id = snapshot.docs[0].id;
                    } else {
                        currentCashier = null;
                    }
                    resolve();
                })
                .catch(() => resolve());
        });
    }

    // ==========================================
    // 6. LOCALSTORAGE (OFFLINE)
    // ==========================================
    function saveToLocalStorage(key, data) {
        try {
            localStorage.setItem(`dashboard_${key}`, JSON.stringify(data));
        } catch(e) {}
    }

    function loadFromLocalStorage() {
        try {
            const services = localStorage.getItem('dashboard_services');
            if (services) allServices = JSON.parse(services);
            const productSales = localStorage.getItem('dashboard_productSales');
            if (productSales) allProductSales = JSON.parse(productSales);
            const clientsData = localStorage.getItem('dashboard_clients');
            if (clientsData) clients = JSON.parse(clientsData);
            const collabData = localStorage.getItem('dashboard_collaborators');
            if (collabData) collaborators = JSON.parse(collabData);
            const productsData = localStorage.getItem('dashboard_products');
            if (productsData) products = JSON.parse(productsData);
            const appData = localStorage.getItem('dashboard_appointments');
            if (appData) appointments = JSON.parse(appData);
            
            const today = new Date().toISOString().split('T')[0];
            todayServices = allServices.filter(s => s.date === today);
            todayProductSales = allProductSales.filter(s => s.date === today);
            
            updateDashboard();
        } catch(e) {}
    }

    // ==========================================
    // 7. ATUALIZAR DASHBOARD
    // ==========================================
    function updateDashboard() {
        updateMetrics();
        updateEmpresaCard();
        updateRecentServices();
        updateUpcomingBirthdays();
        updateFuncionarios();
        updateLowStockAlerts();
        updateChart();
    }

    // ==========================================
    // 8. MÉTRICAS
    // ==========================================
    function updateMetrics() {
        // Caixa Atual
        if (currentCashier) {
            const todayServicesValue = todayServices.reduce((sum, s) => sum + parseFloat(s.value || 0), 0);
            const todayProductsValue = todayProductSales.reduce((sum, s) => sum + parseFloat(s.totalValue || 0), 0);
            const total = (currentCashier.initialValue || 0) + todayServicesValue + todayProductsValue;
            document.getElementById('currentCash').textContent = formatCurrency(total);
            document.getElementById('cashierStatus').textContent = '✅ Caixa aberto';
            document.getElementById('cashierStatus').style.color = '#28a745';
        } else {
            document.getElementById('currentCash').textContent = '€ 0,00';
            document.getElementById('cashierStatus').textContent = '🔒 Caixa fechado';
            document.getElementById('cashierStatus').style.color = '#dc3545';
        }

        // Vendas Hoje - LÍQUIDO (salão)
        let totalSalaoHoje = 0;
        todayServices.forEach(s => {
            totalSalaoHoje += calcularValorLiquidoSalao(s);
        });
        document.getElementById('todaySales').textContent = formatCurrency(totalSalaoHoje);
        document.getElementById('todayServices').textContent = `${todayServices.length} serviços`;

        // Vendas Semana - LÍQUIDO
        const hoje = new Date();
        const inicioSemana = new Date(hoje);
        inicioSemana.setDate(hoje.getDate() - hoje.getDay() + (hoje.getDay() === 0 ? -6 : 1));
        inicioSemana.setHours(0,0,0,0);
        
        const servicosSemana = allServices.filter(s => {
            const data = s.timestamp?.toDate ? s.timestamp.toDate() : new Date(s.timestamp || s.date);
            return data >= inicioSemana;
        });
        let totalSalaoSemana = 0;
        servicosSemana.forEach(s => totalSalaoSemana += calcularValorLiquidoSalao(s));
        document.getElementById('weekSales').textContent = formatCurrency(totalSalaoSemana);
        document.getElementById('weekServices').textContent = `${servicosSemana.length} serviços`;

        // Vendas Mês - LÍQUIDO
        const inicioMes = new Date(hoje.getFullYear(), hoje.getMonth(), 1);
        const servicosMes = allServices.filter(s => {
            const data = s.timestamp?.toDate ? s.timestamp.toDate() : new Date(s.timestamp || s.date);
            return data >= inicioMes;
        });
        let totalSalaoMes = 0;
        servicosMes.forEach(s => totalSalaoMes += calcularValorLiquidoSalao(s));
        document.getElementById('monthSales').textContent = formatCurrency(totalSalaoMes);
        document.getElementById('monthServices').textContent = `${servicosMes.length} serviços`;

        // Produtos Hoje
        const todayProductsValue = todayProductSales.reduce((sum, s) => sum + parseFloat(s.totalValue || 0), 0);
        document.getElementById('todayProducts').textContent = formatCurrency(todayProductsValue);
        document.getElementById('todayProductsCount').textContent = `${todayProductSales.length} produtos`;

        // Colaboradores
        document.getElementById('totalCollaborators').textContent = collaborators.filter(c => c.active !== false).length;

        // Clientes
        document.getElementById('totalClients').textContent = clients.length;

        // Aniversários
        const upcoming = getUpcomingBirthdays();
        document.getElementById('upcomingBirthdays').textContent = upcoming.length;
    }

    // ==========================================
    // 9. CALCULAR VALOR LÍQUIDO DO SALÃO
    // ==========================================
    function calcularValorLiquidoSalao(servico) {
        const colaborador = collaborators.find(c => c.id === servico.collaboratorId);
        if (!colaborador) return parseFloat(servico.value || 0);
        
        let percentualFuncionario = 0;
        if (servico.type === 'manual') {
            percentualFuncionario = parseFloat(colaborador.manualPercent) || 0;
        } else if (servico.type === 'product') {
            percentualFuncionario = parseFloat(colaborador.productPercent) || 0;
        }
        
        const valorServico = parseFloat(servico.value || 0);
        return valorServico * ((100 - percentualFuncionario) / 100);
    }

    // ==========================================
    // 10. EMPRESA CARD
    // ==========================================
    function updateEmpresaCard() {
        let totalBruto = 0;
        let totalComissoes = 0;
        let totalSalao = 0;
        let totalServicos = allServices.length;

        allServices.forEach(s => {
            const valor = parseFloat(s.value || 0);
            totalBruto += valor;
            
            const colaborador = collaborators.find(c => c.id === s.collaboratorId);
            let percentual = 0;
            if (colaborador) {
                if (s.type === 'manual') percentual = parseFloat(colaborador.manualPercent) || 0;
                else if (s.type === 'product') percentual = parseFloat(colaborador.productPercent) || 0;
            }
            totalComissoes += valor * (percentual / 100);
            totalSalao += valor * ((100 - percentual) / 100);
        });

        document.getElementById('empresaFaturamento').textContent = formatCurrency(totalBruto);
        document.getElementById('empresaLucro').textContent = formatCurrency(totalSalao);
        document.getElementById('empresaComissoes').textContent = formatCurrency(totalComissoes);
        
        const ticketMedio = totalServicos > 0 ? totalBruto / totalServicos : 0;
        document.getElementById('empresaTicket').textContent = formatCurrency(ticketMedio);
    }

    // ==========================================
    // 11. SERVIÇOS RECENTES
    // ==========================================
    function updateRecentServices() {
        const container = document.getElementById('recentServicesList');
        const recent = todayServices.slice(0, 5);

        if (recent.length === 0) {
            container.innerHTML = '<p class="text-muted text-center py-3">Nenhum serviço hoje.</p>';
            return;
        }

        let html = '';
        recent.forEach(service => {
            const client = clients.find(c => c.id === service.clientId);
            const clientName = client ? client.name : 'Cliente não encontrado';
            const valorLiquido = calcularValorLiquidoSalao(service);
            
            html += `
                <div class="recent-service-item">
                    <div class="service-info">
                        <div class="name">${service.description || 'Serviço'}</div>
                        <div class="client">${clientName}</div>
                    </div>
                    <div class="service-value">${formatCurrency(valorLiquido)}</div>
                </div>
            `;
        });
        container.innerHTML = html;
    }

    // ==========================================
    // 12. ANIVERSÁRIOS
    // ==========================================
    function getUpcomingBirthdays() {
        const today = new Date();
        const todayMonth = today.getMonth();
        const todayDay = today.getDate();

        return clients.filter(client => {
            if (!client.birthdate) return false;
            const birthdate = new Date(client.birthdate);
            const birthMonth = birthdate.getMonth();
            const birthDay = birthdate.getDate();

            if (birthMonth === todayMonth && birthDay === todayDay) return true;

            const currentYear = today.getFullYear();
            const nextBirthday = new Date(currentYear, birthMonth, birthDay);
            if (nextBirthday < today) nextBirthday.setFullYear(currentYear + 1);
            
            const daysDiff = Math.ceil((nextBirthday - today) / (1000 * 60 * 60 * 24));
            return daysDiff <= 7 && daysDiff > 0;
        }).sort((a, b) => {
            const dateA = new Date(a.birthdate);
            const dateB = new Date(b.birthdate);
            const currentYear = today.getFullYear();
            
            let nextA = new Date(currentYear, dateA.getMonth(), dateA.getDate());
            let nextB = new Date(currentYear, dateB.getMonth(), dateB.getDate());
            if (nextA < today) nextA.setFullYear(currentYear + 1);
            if (nextB < today) nextB.setFullYear(currentYear + 1);
            
            return nextA - nextB;
        });
    }

    function updateUpcomingBirthdays() {
        const container = document.getElementById('upcomingBirthdaysList');
        const upcoming = getUpcomingBirthdays();

        if (upcoming.length === 0) {
            container.innerHTML = '<p class="text-muted text-center py-3">Nenhum aniversário próximo.</p>';
            return;
        }

        const today = new Date();
        const todayMonth = today.getMonth();
        const todayDay = today.getDate();

        let html = '';
        upcoming.forEach(client => {
            const birthdate = new Date(client.birthdate);
            const birthMonth = birthdate.getMonth();
            const birthDay = birthdate.getDate();
            const isToday = (birthMonth === todayMonth && birthDay === todayDay);

            const photoHtml = client.photoUrl ? 
                `<img src="${client.photoUrl}" class="avatar" onerror="this.style.display='none'">` :
                `<div class="avatar-placeholder">${(client.name || '?').charAt(0).toUpperCase()}</div>`;

            html += `
                <div class="birthday-item" onclick="showClientInfo('${client.id}')">
                    ${photoHtml}
                    <div class="info">
                        <div class="name">${client.name}</div>
                        <div class="date">${formatDate(client.birthdate)}</div>
                    </div>
                    <span class="${isToday ? 'badge-today' : 'badge-soon'}">
                        ${isToday ? '🎉 HOJE!' : (birthdayDaysLeft(client.birthdate) === 1 ? 'Amanhã' : `Em ${birthdayDaysLeft(client.birthdate)} dias`)}
                    </span>
                </div>
            `;
        });
        container.innerHTML = html;
    }

    function birthdayDaysLeft(birthdate) {
        const today = new Date();
        const birth = new Date(birthdate);
        const currentYear = today.getFullYear();
        let next = new Date(currentYear, birth.getMonth(), birth.getDate());
        if (next < today) next.setFullYear(currentYear + 1);
        return Math.ceil((next - today) / (1000 * 60 * 60 * 24));
    }

    // ==========================================
    // 13. DESEMPENHO DOS FUNCIONÁRIOS
    // ==========================================
    function updateFuncionarios() {
        const container = document.getElementById('funcionariosCards');
