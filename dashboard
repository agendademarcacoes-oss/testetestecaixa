            const percSalao = 100 - (parseFloat(colab.manualPercent) || 0);

            html += `
                <div class="col-lg-4 col-md-6 col-12 mb-3">
                    <div class="funcionario-card">
                        <div class="card-header-custom" style="background:linear-gradient(135deg, ${cor}, ${cor}dd);">
                            ${fotoHtml}
                            <h6>${colab.name}</h6>
                            <small>${colab.specialty || 'Especialidade não definida'}</small>
                        </div>
                        <div class="card-body-custom">
                            <div class="stat-row">
                                <span class="label">Comissão</span>
                                <span class="value">${colab.manualPercent || 0}%</span>
                            </div>
                            <div class="stat-row">
                                <span class="label">Salão</span>
                                <span class="value positive">${percSalao.toFixed(0)}%</span>
                            </div>
                            <div class="stat-row">
                                <span class="label">Serviços</span>
                                <span class="value">${stats.quantidade}</span>
                            </div>
                            <div class="stat-row">
                                <span class="label">Faturamento</span>
                                <span class="value positive">${formatCurrency(stats.valorBruto)}</span>
                            </div>
                            <div class="stat-row">
                                <span class="label">Comissão Recebida</span>
                                <span class="value">${formatCurrency(stats.valorComissao)}</span>
                            </div>
                            <div class="stat-row" style="border-bottom:none;padding-bottom:0;">
                                <span class="label">Salão Recebe</span>
                                <span class="value positive">${formatCurrency(stats.valorSalao)}</span>
                            </div>
                            <div class="progress-custom">
                                <div class="bar salao" style="width:${percSalao}%;"></div>
                                <div class="bar comissao" style="width:${100-percSalao}%;"></div>
                            </div>
                        </div>
                    </div>
                </div>
            `;
        });

        container.innerHTML = html;
    }

    function calcularEstatisticasFuncionario(colaboradorId) {
        const servicos = allServices.filter(s => s.collaboratorId === colaboradorId);
        let valorBruto = 0;
        let valorComissao = 0;
        let valorSalao = 0;

        servicos.forEach(s => {
            const v = parseFloat(s.value || 0);
            valorBruto += v;
            
            const colab = collaborators.find(c => c.id === colaboradorId);
            let perc = 0;
            if (colab) {
                if (s.type === 'manual') perc = parseFloat(colab.manualPercent) || 0;
                else if (s.type === 'product') perc = parseFloat(colab.productPercent) || 0;
            }
            valorComissao += v * (perc / 100);
            valorSalao += v * ((100 - perc) / 100);
        });

        return {
            valorBruto,
            valorComissao,
            valorSalao,
            quantidade: servicos.length
        };
    }

    // ==========================================
    // 14. ALERTAS DE ESTOQUE BAIXO
    // ==========================================
    function updateLowStockAlerts() {
        const container = document.getElementById('lowStockContainer');
        const list = document.getElementById('lowStockList');
        
        const lowStock = products.filter(p => p.quantity <= p.minQuantity && p.active !== false);

        if (lowStock.length === 0) {
            container.style.display = 'none';
            return;
        }

        container.style.display = 'block';
        let html = '';
        lowStock.forEach(p => {
            html += `
                <div class="stock-alert-item">
                    <span class="product-name">${p.name}</span>
                    <span class="stock-qty">${p.quantity} / ${p.minQuantity} (mínimo)</span>
                </div>
            `;
        });
        list.innerHTML = html;
    }

    // ==========================================
    // 15. GRÁFICO
    // ==========================================
    function updateChart() {
        const hoje = new Date();
        const currentYear = hoje.getFullYear();
        const currentMonth = hoje.getMonth();

        const labels = [];
        const servicesData = [];
        const productsData = [];

        for (let i = 5; i >= 0; i--) {
            const monthDate = new Date(currentYear, currentMonth - i, 1);
            labels.push(monthDate.toLocaleDateString('pt-PT', { month: 'short' }));

            const monthServices = allServices.filter(s => {
                const d = s.timestamp?.toDate ? s.timestamp.toDate() : new Date(s.timestamp || s.date);
                return d.getMonth() === monthDate.getMonth() && d.getFullYear() === monthDate.getFullYear();
            });
            servicesData.push(monthServices.reduce((sum, s) => sum + parseFloat(s.value || 0), 0));

            const monthProducts = allProductSales.filter(s => {
                const d = s.timestamp?.toDate ? s.timestamp.toDate() : new Date(s.timestamp || s.date);
                return d.getMonth() === monthDate.getMonth() && d.getFullYear() === monthDate.getFullYear();
            });
            productsData.push(monthProducts.reduce((sum, s) => sum + parseFloat(s.totalValue || 0), 0));
        }

        const ctx = document.getElementById('monthlySalesChart').getContext('2d');

        if (myChart) myChart.destroy();

        myChart = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: 'Serviços',
                        data: servicesData,
                        backgroundColor: '#26196b',
                        borderColor: '#26196b',
                        borderWidth: 1,
                        borderRadius: 4
                    },
                    {
                        label: 'Produtos',
                        data: productsData,
                        backgroundColor: '#17a2b8',
                        borderColor: '#17a2b8',
                        borderWidth: 1,
                        borderRadius: 4
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'top', labels: { boxWidth: 12, padding: 15 } },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return context.dataset.label + ': ' + formatCurrency(context.raw);
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { callback: function(v) { return '€' + v; } }
                    }
                }
            }
        });
    }

    // ==========================================
    // 16. FUNÇÕES AUXILIARES
    // ==========================================
    function formatCurrency(value) {
        if (typeof value !== 'number') value = parseFloat(value) || 0;
        return '€ ' + value.toFixed(2).replace('.', ',');
    }

    function formatDate(date) {
        if (!date) return '';
        if (typeof date === 'string') date = new Date(date);
        return date.toLocaleDateString('pt-PT');
    }

    function updateLastUpdate() {
        const now = new Date();
        document.getElementById('lastUpdateBadge').innerHTML = 
            `<i class="fas fa-clock me-1"></i>Atualizado ${now.toLocaleTimeString('pt-PT')}`;
    }

    // ==========================================
    // 17. REFRESH
    // ==========================================
    function refreshDashboard() {
        const btn = document.querySelector('.btn-refresh');
        btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Atualizando...';
        btn.disabled = true;

        loadAllData().then(() => {
            btn.innerHTML = '<i class="fas fa-check me-1"></i>Atualizado!';
            setTimeout(() => {
                btn.innerHTML = '<i class="fas fa-sync-alt me-1"></i>Atualizar';
                btn.disabled = false;
            }, 1500);
        }).catch(() => {
            btn.innerHTML = '<i class="fas fa-sync-alt me-1"></i>Atualizar';
            btn.disabled = false;
        });
    }

    // ==========================================
    // 18. FUNÇÕES DE INTERAÇÃO
    // ==========================================
    function showClientInfo(clientId) {
        const client = clients.find(c => c.id === clientId);
        if (!client) return;

        Swal.fire({
            title: client.name,
            html: `
                <div class="text-start">
                    <p><strong>📞 Telefone:</strong> ${client.phone || 'Não informado'}</p>
                    <p><strong>📧 E-mail:</strong> ${client.email || 'Não informado'}</p>
                    <p><strong>🎂 Nascimento:</strong> ${formatDate(client.birthdate) || 'Não informado'}</p>
                    <p><strong>📅 Cadastrado em:</strong> ${client.createdAt ? formatDate(client.createdAt) : 'Não informado'}</p>
                </div>
            `,
            icon: 'info',
            confirmButtonText: 'Fechar'
        });
    }

    function showLoginPrompt() {
        Swal.fire({
            title: 'Acesso Restrito',
            text: 'Faça login para visualizar o dashboard completo.',
            icon: 'warning',
            confirmButtonText: 'Ir para Login',
            showCancelButton: true,
            cancelButtonText: 'Cancelar'
        }).then(result => {
            if (result.isConfirmed) {
                window.location.href = '/';
            }
        });
    }

    // ==========================================
    // 19. EXPOR FUNÇÕES GLOBAIS
    // ==========================================
    window.refreshDashboard = refreshDashboard;
    window.showClientInfo = showClientInfo;

    // ==========================================
    // 20. LOG DE INICIALIZAÇÃO
    // ==========================================
    console.log('✅ Dashboard carregado com sucesso!');
    console.log('📌 Funcionalidades:');
    console.log('   - Métricas em tempo real (Caixa, Vendas, Produtos)');
    console.log('   - Visão geral da empresa (Faturamento, Lucro, Comissões)');
    console.log('   - Gráfico de vendas mensais');
    console.log('   - Serviços recentes do dia');
    console.log('   - Próximos aniversários');
    console.log('   - Desempenho dos funcionários');
    console.log('   - Alertas de estoque baixo');
    console.log('   - Integração com Firebase');
    console.log('   - Fallback para localStorage (offline)');
    console.log('   - Atualização automática e manual');

</script>

